
{
  "manifest_version": 3,

  "name": "AtCoder Companion",

  "version": "1.0",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://atcoder.jp/*",
    "http://localhost:10043/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "image/round-add-button.png",
    "48": "image/round-add-button.png",
    "128": "image/round-add-button.png"
  },

  "action": {
    "default_title": "AtCoder Companion"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],

      "matches": [
        "https://atcoder.jp/*"
      ]
    }
  ]
}
